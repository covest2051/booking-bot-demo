# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram id администраторов через запятую (свой id — у @userinfobot).
# Администратор должен один раз нажать /start в боте, иначе Telegram не даст боту ему писать.
ADMIN_IDS=

# true — клиент после записи видит копию уведомления администратору (для демонстрации заказчикам)
DEMO_MODE=true

# Пароль базы данных — любой длинный
POSTGRES_PASSWORD=
